{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oursharedevents.com/schemas/checkpermissions.schema.json",
  "title": "CheckPermissions Response",
  "description": "Permission verification response with detailed diagnostics and recommendations. Validates Worker auth and D1 database access.",
  "type": "object",
  "required": ["ok"],
  "additionalProperties": false,
  "oneOf": [
    {
      "properties": {
        "ok": { "const": true },
        "value": { "$ref": "#/$defs/CheckPermissionsValue" }
      },
      "required": ["ok", "value"]
    },
    {
      "properties": {
        "ok": { "const": false },
        "code": { "$ref": "#/$defs/ErrorCode" },
        "message": { "type": "string", "minLength": 1 }
      },
      "required": ["ok", "code", "message"]
    }
  ],
  "$defs": {
    "CheckPermissionsValue": {
      "type": "object",
      "required": ["status", "message", "details"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["ok", "error"],
          "description": "Overall permission status"
        },
        "message": {
          "type": "string",
          "description": "Human-readable summary message"
        },
        "details": {
          "$ref": "#/$defs/PermissionDetails"
        },
        "nextSteps": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Next actions when permissions are ok"
        },
        "recommendations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Fix recommendations when permissions have issues"
        },
        "helpUrl": {
          "type": "string",
          "description": "Link to deployment guide documentation"
        }
      }
    },
    "PermissionDetails": {
      "type": "object",
      "required": ["brand", "deployment", "database", "auth"],
      "additionalProperties": true,
      "properties": {
        "brand": {
          "$ref": "#/$defs/BrandInfo"
        },
        "deployment": {
          "$ref": "#/$defs/DeploymentInfo"
        },
        "database": {
          "$ref": "#/$defs/DatabaseInfo"
        },
        "auth": {
          "$ref": "#/$defs/AuthInfo"
        },
        "recommendations": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Recommendations accumulated during checks"
        }
      }
    },
    "BrandInfo": {
      "type": "object",
      "required": ["id", "name"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "description": "Brand identifier"
        },
        "name": {
          "type": "string",
          "description": "Brand display name"
        }
      }
    },
    "DeploymentInfo": {
      "type": "object",
      "required": ["configured"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "description": "Deployment URL"
        },
        "configured": {
          "type": "boolean",
          "description": "Whether deployment is configured"
        },
        "error": {
          "type": "string",
          "description": "Error message if deployment check failed"
        }
      }
    },
    "DatabaseInfo": {
      "type": "object",
      "required": ["accessible", "message"],
      "additionalProperties": false,
      "properties": {
        "accessible": {
          "type": "boolean",
          "description": "Whether D1 database is accessible"
        },
        "name": {
          "type": "string",
          "description": "Database name (if accessible)"
        },
        "id": {
          "type": "string",
          "description": "Database ID (if accessible)"
        },
        "message": {
          "type": "string",
          "description": "Status message"
        },
        "error": {
          "type": "string",
          "description": "Error message if access failed"
        }
      }
    },
    "AuthInfo": {
      "type": "object",
      "required": ["authenticated"],
      "additionalProperties": false,
      "properties": {
        "authenticated": {
          "type": "boolean",
          "description": "Whether admin auth (Bearer token) is valid"
        },
        "method": {
          "type": "string",
          "enum": ["bearer", "cf_access"],
          "description": "Authentication method used"
        },
        "error": {
          "type": "string",
          "description": "Error message if auth check failed"
        }
      }
    },
    "ErrorCode": {
      "type": "string",
      "enum": ["NOT_FOUND", "INTERNAL", "UNAUTHORIZED", "BAD_REQUEST"],
      "description": "Standard error codes"
    }
  },
  "examples": [
    {
      "ok": true,
      "value": {
        "status": "ok",
        "message": "All permissions are properly configured!",
        "details": {
          "brand": {
            "id": "root",
            "name": "Default Brand"
          },
          "deployment": {
            "url": "https://oursharedevents.com",
            "configured": true
          },
          "database": {
            "accessible": true,
            "name": "ocr-db-production",
            "id": "d1-database-id",
            "message": "D1 database access granted"
          },
          "auth": {
            "authenticated": true,
            "method": "bearer"
          },
          "recommendations": []
        },
        "nextSteps": [
          "Your deployment is ready to use",
          "Test the API: https://oursharedevents.com/health"
        ]
      }
    },
    {
      "ok": true,
      "value": {
        "status": "error",
        "message": "Permission issues detected",
        "details": {
          "brand": {
            "id": "root",
            "name": "Default Brand"
          },
          "deployment": {
            "configured": false,
            "error": "Worker not deployed"
          },
          "database": {
            "accessible": false,
            "message": "D1 database not provisioned",
            "error": "Database binding not found"
          },
          "auth": {
            "authenticated": false,
            "error": "ADMIN_KEY not configured"
          },
          "recommendations": [
            "Deploy the Worker with wrangler deploy --env staging",
            "Provision D1 database and apply migrations"
          ]
        },
        "recommendations": [
          "Deploy the Worker with wrangler deploy --env staging",
          "Provision D1 database and apply migrations"
        ],
        "helpUrl": "See docs/deployment/DEPLOYMENT.md for detailed instructions"
      }
    },
    {
      "ok": false,
      "code": "NOT_FOUND",
      "message": "Brand not found: invalid"
    }
  ]
}
