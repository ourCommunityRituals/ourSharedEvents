  "info": {
    "name": "OSE Pages - Staging",
    "description": "Frontend HTML surface collection for ourSharedEvents.\nSeparated from API. Covers all 5 MVP surfaces + form pages + aliases.\n\nRequires: OSE - Staging environment.",
