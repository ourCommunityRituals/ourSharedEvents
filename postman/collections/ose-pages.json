    {
      "name": "2. Admin Surface",
      "description": "Admin dashboard (auth required). Uses Bearer token from env.",
      "auth": {
        "type": "bearer",
        "bearer": [{ "key": "token", "value": "{{adminKey}}", "type": "string" }]
      },
      "item": [
        {
          "name": "GET /admin",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test('Returns HTML', function() {",
                  "        pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "    });",
                  "",
                  "    pm.test('Has admin content', function() {",
                  "        pm.expect(pm.response.text().toLowerCase()).to.include('admin');",
                  "    });",
                  "} else {",
                  "    pm.test('Returns 401 without valid token', function() {",
                  "        pm.response.to.have.status(401);",
                  "    });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/admin",
              "host": ["{{baseUrl}}"],
              "path": ["admin"]
