            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// SharedReport is feature-flag gated (analytics.shared-report).",
                  "// Returns 200 HTML when enabled, 403 JSON with REPORT_DISABLED when off.",
                  "pm.test('Returns 200 (enabled) or 403 (flag off)', function() {",
                  "    pm.expect([200, 403]).to.include(pm.response.code);",
                  "});",
                  "",
                  "if (pm.response.code === 200) {",
                  "    pm.test('Is HTML', function() {",
                  "        pm.expect(pm.response.headers.get('Content-Type')).to.include('text/html');",
                  "    });",
                  "    pm.test('Has DOCTYPE', function() {",
                  "        pm.expect(pm.response.text()).to.include('<!DOCTYPE html>');",
                  "    });",
                  "} else if (pm.response.code === 403) {",
