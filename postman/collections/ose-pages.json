{
  "info": {
    "name": "OSE Pages - Staging",
    "description": "Frontend HTML surface collection for ourSharedEvents.\nSeparated from API. Covers all 5 MVP surfaces + form pages + aliases.\n\nRequires: OSE - Staging environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "ose-pages"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": ["pm.variables.set('requestStartTime', Date.now());"]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const elapsed = Date.now() - pm.variables.get('requestStartTime');",
          "pm.test(`Response time < 3000ms (actual: ${elapsed}ms)`, function() {",
          "    pm.expect(elapsed).to.be.below(3000);",
          "});"
        ]
      }
    }
  ],
