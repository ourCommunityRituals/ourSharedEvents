{
  "name": "@ocr/flags",
  "version": "0.1.0",
  "description": "Feature-flag runtime binding for OCR Brain contract (flags-contract.yaml)",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./adapters/memory": {
      "types": "./src/adapters/memory.ts",
      "import": "./src/adapters/memory.ts",
      "default": "./src/adapters/memory.ts"
    },
    "./adapters/sqlite": {
      "types": "./src/adapters/sqlite.ts",
      "import": "./src/adapters/sqlite.ts",
      "default": "./src/adapters/sqlite.ts"
    },
    "./adapters/d1": {
      "types": "./src/adapters/d1.ts",
      "import": "./src/adapters/d1.ts",
      "default": "./src/adapters/d1.ts"
    },
    "./adapters/postgres": {
      "types": "./src/adapters/postgres.ts",
      "import": "./src/adapters/postgres.ts",
      "default": "./src/adapters/postgres.ts"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "generate": "node scripts/generate-from-yaml.mjs",
    "check:generated": "node scripts/generate-from-yaml.mjs --check",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:level0": "python3 tests/level0_security.py"
  },
  "peerDependencies": {
    "better-sqlite3": "*",
    "pg": "*"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "better-sqlite3": "^11.0.0",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "js-yaml": "^4.1.0",
    "pg": "^8.11.0",
    "pg-mem": "^3.0.5",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
