{
  "_comment": "Merge these keys into ~/.claude/settings.json (do not replace the file). Keep your existing allow list, enabledPlugins and the mapmap entries. Phase 0 + Phase 1 of .claude/outputs/CCR-CLAUDE-USAGE-OPTIMIZATION-2026-10-11.md. Delete this _comment key when merging.",

  "effortLevel": "high",
  "fastMode": false,

  "permissions": {
    "deny": [
      "mcp__plugin_mapmap_mapmap",
      "Read(~/.claude/config.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(**/.dev.vars)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/actions-runner*/.credentials)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler deploy*)",
      "Bash(npx wrangler secret put*)",
      "Bash(npx wrangler secret delete*)",
      "Bash(npx wrangler d1 migrations apply * --remote*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh pr merge * --admin*)",
      "Bash(gh secret set*)",
      "Bash(gh variable set*)",
      "PowerShell(npx wrangler deploy*)",
      "PowerShell(git push --force*)",
      "PowerShell(gh pr merge * --admin*)"
    ]
  },

