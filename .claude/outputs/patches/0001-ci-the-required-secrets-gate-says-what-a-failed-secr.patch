From 89609f5db0d7016feea7b8133cc861dbf72f3180 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 19 Oct 2026 21:59:33 +0000
Subject: [PATCH 1/2] ci: the required-secrets gate says what a failed secret
 list was

Part of OSE-1731

A rejected Cloudflare token (code 10000) used to print "<SECRET> is not
set ... Provision it: bash scripts/set-secrets.sh", which overwrites the
encryption key and peppers. The gate now captures wrangler's exit code and
classify-wrangler-failure.sh labels auth, network and other failures, names
the environment, warns against set-secrets.sh, and repeats the output only
with header lines and token-like runs removed. Fail-closed is unchanged, and
a genuinely missing name still reads as before.

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .github/workflows/oursharedevents-ci.yml      |   9 +-
 scripts/ci/classify-wrangler-failure.sh       |  53 +++++++
 .../unit/ci/classify-wrangler-failure.test.js | 129 ++++++++++++++++++
 3 files changed, 189 insertions(+), 2 deletions(-)
 create mode 100755 scripts/ci/classify-wrangler-failure.sh
 create mode 100644 tests/unit/ci/classify-wrangler-failure.test.js

diff --git a/.github/workflows/oursharedevents-ci.yml b/.github/workflows/oursharedevents-ci.yml
index 2ee1fbb..1817ae3 100644
--- a/.github/workflows/oursharedevents-ci.yml
+++ b/.github/workflows/oursharedevents-ci.yml
@@ -1246,7 +1246,9 @@ jobs:
           CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
         working-directory: ${{ env.WORKER_DIR }}
         run: |
-          OUT="$(npx wrangler secret list --env staging 2>&1 || true)"
+          # A failed `secret list` is an auth or network finding, never "not set" (OSE-1731).
+          OUT="$(npx wrangler secret list --env staging 2>&1)" && RC=0 || RC=$?
+          bash ../../scripts/ci/classify-wrangler-failure.sh "$RC" "$OUT" staging
           for SECRET in SHARED_REPORT_SIGNING_SECRET FORMS_ENCRYPTION_KEY FORMS_HASH_PEPPER RATE_LIMIT_KEY_PEPPER; do
             if ! echo "$OUT" | grep -q "$SECRET"; then
               echo "::error::$SECRET is not set on the staging worker — refusing to migrate remote D1 for a deploy that would ship a fail-closed corner inert (or, for FORMS_HASH_PEPPER, a masked 503 per OSE-1343; for RATE_LIMIT_KEY_PEPPER, IP-reversible rate-limit keys per OSE-1447). Provision it: bash scripts/set-secrets.sh staging"
@@ -2597,7 +2599,10 @@ jobs:
           CLOUDFLARE_ACCOUNT_ID: ${{ secrets.CLOUDFLARE_ACCOUNT_ID }}
         working-directory: ${{ env.WORKER_DIR }}
         run: |
-          OUT="$(npx wrangler secret list --env production 2>&1 || true)"
+          # A failed `secret list` is an auth or network finding, never "not set" (OSE-1731).
+          # It also keeps the forbidden-name check below from passing on an empty list.
+          OUT="$(npx wrangler secret list --env production 2>&1)" && RC=0 || RC=$?
+          bash ../../scripts/ci/classify-wrangler-failure.sh "$RC" "$OUT" production
           for SECRET in SHARED_REPORT_SIGNING_SECRET FORMS_ENCRYPTION_KEY FORMS_HASH_PEPPER RATE_LIMIT_KEY_PEPPER ANON_ID_HASH_PEPPER; do
             if ! echo "$OUT" | grep -q "$SECRET"; then
               echo "::error::$SECRET is not set on the production worker — refusing to migrate remote D1 for a deploy that would ship a fail-closed corner inert (or, for FORMS_HASH_PEPPER, a masked 503 per OSE-1343; for RATE_LIMIT_KEY_PEPPER, IP-reversible rate-limit keys per OSE-1447; for ANON_ID_HASH_PEPPER, scans with no id and no return counts per OSE-1659). Provision it: bash scripts/set-secrets.sh production"
diff --git a/scripts/ci/classify-wrangler-failure.sh b/scripts/ci/classify-wrangler-failure.sh
new file mode 100755
index 0000000..2c6ac95
--- /dev/null
+++ b/scripts/ci/classify-wrangler-failure.sh
@@ -0,0 +1,53 @@
+#!/usr/bin/env bash
+# Say what a failed `wrangler secret list` was, instead of "the secret is not set".
+#
+#   OUT="$(npx wrangler secret list --env staging 2>&1)" && RC=0 || RC=$?
+#   bash ../../scripts/ci/classify-wrangler-failure.sh "$RC" "$OUT" staging
+#
+# Exit 0 when wrangler succeeded (RC = 0) and nothing is printed. Otherwise print
+# ONE ::error:: line that names the failure class (auth, network, other) and exit 1.
+#
+# Why: the secrets gate used `... 2>&1 || true`, so any wrangler failure (a rejected
+# token, a missing permission, a Cloudflare 5xx) read as "<SECRET> is not set ...
+# Provision it: bash scripts/set-secrets.sh <env>". That script puts the encryption
+# key and the peppers without checking for a value that is already there, so the
+# wrong-cause message could lead to replacing keys that were fine (OSE-1731, found
+# during OSE-1730). The gate stays fail-closed; only the diagnosis changes.
+#
+# The wrangler output is repeated only after header lines and long token-like runs
+# are removed. Nothing here reads or prints a credential.
+set -euo pipefail
+
+RC="${1:-}"
+OUT="${2:-}"
+ENVIRONMENT="${3:-unknown}"
+
+if [[ ! "$RC" =~ ^[0-9]+$ ]]; then
+  echo "::error::classify-wrangler-failure.sh: first argument must be wrangler's exit code" >&2
+  exit 2
+fi
+if [[ "$RC" -eq 0 ]]; then
+  exit 0
+fi
+
+AUTH='Authentication error|Invalid access token|Unable to authenticate|Too many authentication failures|\[code: (10000|10001|10502|9106|9107|9108|9109)\]|Unauthorized|Forbidden'
+NET='ENOTFOUND|ECONNRESET|ECONNREFUSED|ETIMEDOUT|EAI_AGAIN|fetch failed|socket hang up|Bad Gateway|Service Unavailable|Gateway Time-?out'
+
+if printf '%s' "$OUT" | grep -qiE "$AUTH"; then
+  CLASS='authentication failure'
+  HINT='CLOUDFLARE_API_TOKEN_OSE is rejected, belongs to another account than CLOUDFLARE_ACCOUNT_ID, or lacks a permission. Check it from your own terminal with GET /accounts/<id>/tokens/verify (OSE-1730).'
+elif printf '%s' "$OUT" | grep -qiE "$NET"; then
+  CLASS='network failure'
+  HINT='Cloudflare was unreachable from the runner. Re-run once; if it repeats, check Cloudflare status.'
+else
+  CLASS='failure'
+  HINT='Read the wrangler output below.'
+fi
+
+echo "::error::Cloudflare ${CLASS} while listing secrets on ${ENVIRONMENT} (wrangler exit ${RC}). This is NOT a missing-secret finding. ${HINT} Do NOT run scripts/set-secrets.sh for this: it overwrites existing keys."
+
+# Repeat the output for the log with header lines and token-like runs removed.
+printf '%s\n' "$OUT" \
+  | { grep -viE 'authorization|bearer|x-auth' || true; } \
+  | sed -E 's/[A-Za-z0-9_-]{32,}/***/g'
+exit 1
diff --git a/tests/unit/ci/classify-wrangler-failure.test.js b/tests/unit/ci/classify-wrangler-failure.test.js
new file mode 100644
index 0000000..decd66d
--- /dev/null
+++ b/tests/unit/ci/classify-wrangler-failure.test.js
@@ -0,0 +1,129 @@
+/**
+ * The "required secrets present" gate must not read a Cloudflare failure as a
+ * missing secret (OSE-1731, found during OSE-1730).
+ *
+ * Seen red: against the old workflow (`... 2>&1 || true`) the YAML cases fail, and
+ * with no script the behaviour cases fail. A rejected token (code 10000) used to
+ * print "<SECRET> is not set ... Provision it: bash scripts/set-secrets.sh".
+ */
+const { spawnSync } = require('node:child_process');
+const { readFileSync, existsSync } = require('node:fs');
+const { join } = require('node:path');
+
+const ROOT = join(__dirname, '..', '..', '..');
+const SCRIPT = join(ROOT, 'scripts', 'ci', 'classify-wrangler-failure.sh');
+const GATE = 'Gate: required secrets present (pre-migrate, fail-closed corner) (OSE-1343)';
+
+const AUTH_OUT = [
+  '✘ [ERROR] A request to the Cloudflare API (/accounts/0123456789abcdef0123456789abcdef/workers/scripts/oursharedevents-stg/secrets) failed.',
+  '  Authentication error [code: 10000]',
+  '✘ [ERROR] A request to the Cloudflare API (/accounts) failed.',
+  '  Invalid access token [code: 9109]',
+].join('\n');
+
+function run(rc, out, env = 'staging') {
+  const r = spawnSync('bash', [SCRIPT, String(rc), out, env], { encoding: 'utf8' });
+  return { status: r.status, stdout: r.stdout ?? '', stderr: r.stderr ?? '' };
+}
+
+describe('classify-wrangler-failure.sh', () => {
+  test('exists', () => {
+    expect(existsSync(SCRIPT)).toBe(true);
+  });
+
+  test('wrangler success prints nothing and exits 0', () => {
+    const r = run(0, '[{"name":"FORMS_HASH_PEPPER","type":"secret_text"}]');
+    expect(r.status).toBe(0);
+    expect(r.stdout).toBe('');
+  });
+
+  test('a rejected token is an authentication failure, not a missing secret', () => {
+    const r = run(1, AUTH_OUT);
+    expect(r.status).toBe(1);
+    expect(r.stdout).toMatch(/::error::Cloudflare authentication failure/);
+    expect(r.stdout).toMatch(/NOT a missing-secret finding/);
+    expect(r.stdout).not.toMatch(/is not set/);
+    expect(r.stdout).not.toMatch(/Provision it/);
+    // it warns against the key-overwriting script instead of recommending it
+    expect(r.stdout).toMatch(/Do NOT run scripts\/set-secrets\.sh/);
+  });
+
+  test('the throttle code (10502) is also an authentication failure', () => {
+    const r = run(1, 'Too many authentication failures. Please try again later. [code: 10502]');
+    expect(r.status).toBe(1);
+    expect(r.stdout).toMatch(/authentication failure/);
+  });
+
+  test('an unreachable Cloudflare is a network failure', () => {
+    const r = run(
+      1,
+      'TypeError: fetch failed\n  cause: Error: getaddrinfo ENOTFOUND api.cloudflare.com'
+    );
+    expect(r.status).toBe(1);
+    expect(r.stdout).toMatch(/::error::Cloudflare network failure/);
+    expect(r.stdout).not.toMatch(/is not set/);
+  });
+
+  test('any other wrangler failure still fails closed and is labelled', () => {
+    const r = run(7, 'something unexpected');
+    expect(r.status).toBe(1);
+    expect(r.stdout).toMatch(/::error::Cloudflare failure/);
+    expect(r.stdout).toMatch(/wrangler exit 7/);
+    expect(r.stdout).toMatch(/NOT a missing-secret finding/);
+  });
+
+  test('names the environment it checked', () => {
+    expect(run(1, AUTH_OUT, 'production').stdout).toMatch(/on production \(wrangler exit 1\)/);
+  });
+
+  test('never repeats a header line or a token-like run', () => {
+    const secret = 'abcdefghijklmnopqrstuvwxyz0123456789ABCD';
+    const r = run(
+      1,
+      [
+        `Authorization: Bearer ${secret}`,
+        `token=${secret}`,
+        'Authentication error [code: 10000]',
+      ].join('\n')
+    );
+    expect(r.stdout).not.toContain(secret);
+    expect(r.stdout).not.toMatch(/Bearer/i);
+    expect(r.stdout).toMatch(/Authentication error \[code: 10000\]/);
+  });
+
+  test('masks a 32-character account id inside a request path', () => {
+    expect(run(1, AUTH_OUT).stdout).not.toContain('0123456789abcdef0123456789abcdef');
+  });
+
+  test('refuses a missing or non-numeric exit code', () => {
+    expect(run('x', AUTH_OUT).status).toBe(2);
+  });
+});
+
+describe('the two secrets gates call it and do not swallow the exit code', () => {
+  const yaml = require('js-yaml');
+  const workflow = yaml.load(
+    readFileSync(join(ROOT, '.github', 'workflows', 'oursharedevents-ci.yml'), 'utf8')
+  );
+  const gate = (job) => workflow.jobs[job].steps.find((s) => s.name === GATE);
+
+  for (const [job, env] of [
+    ['deploy-staging', 'staging'],
+    ['deploy-production', 'production'],
+  ]) {
+    test(`${job}: no "|| true" on the secret list`, () => {
+      const run = gate(job)?.run ?? '';
+      expect(run).toContain(`npx wrangler secret list --env ${env}`);
+      expect(run).not.toMatch(/secret list[^\n]*\|\|\s*true/);
+    });
+
+    test(`${job}: classifies a wrangler failure before it checks any name`, () => {
+      const run = gate(job)?.run ?? '';
+      expect(run).toMatch(/&& RC=0 \|\| RC=\$\?/);
+      const call = run.indexOf(`classify-wrangler-failure.sh "$RC" "$OUT" ${env}`);
+      const firstLoop = run.indexOf('for SECRET in');
+      expect(call).toBeGreaterThan(-1);
+      expect(firstLoop).toBeGreaterThan(call);
+    });
+  }
+});
