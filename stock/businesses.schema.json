{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Stock businesses",
  "description": "Businesses on each node's commercial strips, written by the morning search to stock-out/businesses.json.",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["name", "address", "node", "anchor"],
    "properties": {
      "name": { "type": "string", "minLength": 1 },
      "address": { "type": "string", "minLength": 1 },
      "node": {
        "enum": [
          "blue-island",
          "beverly",
          "auburn-gresham",
          "evergreen-park",
          "oak-lawn",
          "mount-greenwood"
        ]
      },
      "anchor": { "type": "boolean" }
    }
  }
}
