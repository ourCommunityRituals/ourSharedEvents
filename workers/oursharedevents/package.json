{
  "name": "oursharedevents-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "measure:startup": "node scripts/measure-startup.mjs",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "secrets:staging": "bash ../../scripts/set-secrets.sh staging",
    "secrets:prod": "bash ../../scripts/set-secrets.sh production",
    "test": "vitest run",
    "test:node": "vitest run --config vitest.node.config.mts",
    "test:workers": "vitest run --config vitest.workers.config.mts",
    "test:mutation": "stryker run",
    "test:partition": "node scripts/vitest-projects-partition.mjs",
    "test:schema": "vitest run tests/schema.spec.ts",
    "test:constraints": "vitest run tests/constraints.spec.ts",
    "test:d1": "vitest run tests/schema.spec.ts tests/constraints.spec.ts",
    "test:forms": "vitest run tests/forms-schema.spec.ts tests/forms-constraints.spec.ts tests/forms-security.spec.ts",
    "test:all": "vitest run",
    "test:a11y": "vitest run --config vitest.config.a11y.mts",
    "dev:local-launch": "wrangler d1 migrations apply ocr-db-local --local && npm run seed:local-launch && wrangler dev --ip 127.0.0.1 --port 8787",
    "seed:local-launch": "wrangler d1 execute ocr-db-local --local --file ../../tests/ui/smoke/fixtures/launch-story-local.sql",
    "test:local:launch-contracts": "vitest run tests/public-event-page.spec.ts tests/public-event-calendar.spec.ts tests/admin-draft-preview.spec.ts tests/admin-event-lifecycle-ui.spec.ts tests/admin-ui.spec.ts tests/poster-qr.spec.ts tests/tier-equity-sort.spec.ts"
  },
  "dependencies": {
    "@ocr/data-provider": "file:../../packages/data-provider",
    "@ocr/flags": "file:../../packages/flags",
    "@ocr/ui": "file:../../../packages/ui",
    "h3-js": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.2",
    "@cloudflare/workers-types": "^4.0.0",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/jsdom": "^28.0.1",
    "axe-core": "^4.11.3",
    "eslint-plugin-security": "^4.0.0",
    "fast-check": "^4.9.0",
    "js-yaml": "^4.3.2",
    "jsdom": "^29.0.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.3",
    "wrangler": "^4.81.1"
  },
  "overrides": {
    "undici": "7.29.0",
    "ws": "8.21.0",
    "sharp": "0.35.0"
  }
}
