{
  "name": "oursharedevents-worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy:staging": "wrangler deploy --env staging",
    "deploy:prod": "wrangler deploy --env production",
    "secrets:staging": "bash ../../scripts/set-secrets.sh staging",
    "secrets:prod": "bash ../../scripts/set-secrets.sh production",
    "test": "vitest run",
    "test:schema": "vitest run tests/schema.spec.ts",
    "test:constraints": "vitest run tests/constraints.spec.ts",
    "test:d1": "vitest run tests/schema.spec.ts tests/constraints.spec.ts",
    "test:forms": "vitest run tests/forms-schema.spec.ts tests/forms-constraints.spec.ts tests/forms-security.spec.ts",
    "test:all": "vitest run",
    "test:a11y": "vitest run --config vitest.config.a11y.mts"
  },
  "dependencies": {
    "@ocr/flags": "file:../../../packages/flags"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.2",
    "@cloudflare/workers-types": "^4.0.0",
    "@types/jsdom": "^28.0.1",
    "axe-core": "^4.11.3",
    "eslint-plugin-security": "^4.0.0",
    "jsdom": "^29.0.2",
    "typescript": "^5.0.0",
    "vitest": "^4.1.3",
    "wrangler": "^4.81.1"
  }
}
