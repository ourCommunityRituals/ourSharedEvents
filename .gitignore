# Clasp (Apps Script deployment)
# All clasp config files contain real Google Apps Script project IDs
# and must not be committed to version control.
.clasp.json
.clasp.json.archived
.clasp.tmp
.clasp-staging.json
.clasp-staging.json.archived
.clasp-production.json
.clasp-production.json.archived
.clasprc.json
.clasp-creds.json

# Node modules
node_modules/
# A worktree may link node_modules to the main checkout
# (scripts/worktree-link-deps.mjs); `node_modules/` does not match a symlink.
node_modules
yarn.lock

# Environment variables
.env
.env.local
.env.*.local

# Wrangler local dev secrets/vars — machine-local, may contain the DEV_OPEN_ADMIN
# bypass and dev ADMIN_KEY. NEVER commit.
.dev.vars
.dev.vars.*

# IDE
.vscode/
.idea/

# Local reference/test binaries dropped into .claude/inputs (poster art, screenshots,
# etc.) — the tracked .md notes stay committable; never let a stray `git add .`
# pull a multi-MB image into the repo.
.claude/inputs/*.png
.claude/inputs/*.PNG
.claude/inputs/*.jpg
.claude/inputs/*.jpeg
.claude/inputs/*.webp
.claude/inputs/*.gif
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# The stock workflow's working files (scripts/stock/run-day.mjs): search output,
# accepted rows and manifests. CI passes them between jobs as artifacts.
stock-out/

# Test reports
newman-reports/
**/reports/mutation/
.stryker-tmp/
playwright-report/
playwright-report-*/
test-results/
.test-results/
.test-data/
test-dashboard/

# Test history database (keep local, contains all historical test runs)
.test-results/test-history.json

# Cloudflare Wrangler local state (D1 SQLite, miniflare)
.wrangler/

# Files the operator saves for scripts/prod-preflight.mjs (secret NAMES, migration
# lists, CI run summaries). Read locally, never committed.
.preflight/

# The recovery runbook used to export table rows to backup/*.json. No runbook does
# now (tests/integration/runbook-dangerous-commands.test.js), but if a file is
# saved there by habit, at the root or inside the Worker folder, git must not
# offer to commit it.
backup/

# Visual baselines are per platform. CI runs on Linux, so the win32 PNGs that a
# local Windows run writes next to the visual specs are never committed.
tests/playwright/*-snapshots/*-win32.png

# Build outputs
dist/
build/

# Deployment history (local only)
.deployment-history.json

# Minified template build artifacts
cloudflare-proxy/templates-min/

# SSH keys and credentials — never commit
id_ed25519*
id_rsa*
*.pem
*.pud.txt

# Claude Code local config — machine-specific, not project state.
# .claude/agents/ is project state (the extended scrum team, reviewed like code),
# so it is tracked; personal agents belong in ~/.claude/agents/.
.claude/settings.local.json
.claude/worktrees/

# Generated audit/report files
dependabot-alerts.json
npm-audit.json

# Postman desktop sync artifacts

# Python bytecode
__pycache__/
*.pyc

# measure-startup.mjs temp files (workers/oursharedevents/scripts/measure-startup.mjs)
.h3-stub.measure-startup.tmp.mjs
.wrangler.measure-startup.tmp.toml

# StrykerJS output (stryker.ci-scripts.conf.mjs)
/reports/
