{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Canonical list of GitHub Actions secrets required by this repository (Story 2, updated SEC-1.2)",
  "version": "3.0.0",
  "lastUpdated": "2025-12-20",
  "documentation": "docs/CLOUDFLARE_SECRETS.md",
  "scopedTokensRunbook": "docs/RUNBOOK-SEC-1.2-SCOPED-API-TOKENS.md",
  "verificationScript": "scripts/verify-secrets.js",

  "namingConvention": {
    "pattern": "{PROVIDER}_{PURPOSE}_{SCOPE}",
    "rules": [
      "Use SCREAMING_SNAKE_CASE",
      "Prefix with provider (CF, GCP, etc.)",
      "Keep names under 30 characters",
      "Avoid environment suffixes (use GitHub Environments instead)"
    ],
    "examples": {
      "good": ["CF_DEPLOY_TOKEN", "GCP_SA_PRIVATE_KEY", "ADMIN_KEY_ROOT"],
      "bad": ["cloudflare-api-token", "TOKEN", "CF_DEPLOY_TOKEN_PROD"]
    }
  },

  "stage1": {
    "description": "Secrets required for Stage-1 deployment pipeline",
    "required": [
      {
        "name": "GOOGLE_CLIENT_EMAIL",
        "description": "Google service account email for Sheets API",
        "category": "google",
        "rotationPolicy": "90 days",
        "alternatives": ["GOOGLE_SA_CLIENT_EMAIL"],
        "story": "1.1",
        "setup": "docs/env/GOOGLE_SERVICE_ACCOUNT_SETUP.md"
      },
      {
        "name": "GOOGLE_PRIVATE_KEY",
        "description": "Google service account private key (PEM format)",
        "category": "google",
        "rotationPolicy": "90 days",
        "alternatives": ["GOOGLE_SA_PRIVATE_KEY_PEM"],
        "story": "1.1",
        "setup": "docs/env/GOOGLE_SERVICE_ACCOUNT_SETUP.md"
      },
      {
        "name": "STAGING_SHEETS_SPREADSHEET_ID",
        "description": "Staging environment spreadsheet ID",
        "category": "google",
        "environment": "staging",
        "story": "1.1"
      },
      {
        "name": "CLOUDFLARE_API_TOKEN",
        "description": "Scoped Cloudflare API token for Worker deployment (least-privilege)",
        "category": "cloudflare",
        "rotationPolicy": "90 days",
        "alternatives": ["CF_DEPLOY_TOKEN"],
        "story": "SEC-1.2",
        "setup": "docs/RUNBOOK-SEC-1.2-SCOPED-API-TOKENS.md#5-token-creation-guide",
        "requiredPermissions": [
          "Workers Scripts: Edit",
          "Workers Routes: Edit",
          "Account Settings: Read"
        ],
        "zoneRestrictions": ["eventangle.com"],
        "securityNotes": "Must be scoped token, NOT global API key. Verify token cannot access DNS or billing."
      },
      {
        "name": "CLOUDFLARE_ACCOUNT_ID",
        "description": "Cloudflare account identifier",
        "category": "cloudflare",
        "alternatives": ["CF_ACCOUNT_ID"]
      },
      {
        "name": "OAUTH_CREDENTIALS",
        "description": "Clasp OAuth credentials for Apps Script deployment",
        "category": "apps_script",
        "rotationPolicy": "on expiration"
      }
    ],
    "optional": [
      {
        "name": "GOOGLE_SA_CLIENT_EMAIL",
        "description": "Service account email (new naming convention)",
        "category": "google"
      },
      {
        "name": "GOOGLE_SA_PRIVATE_KEY_PEM",
        "description": "Private key in PEM format (new naming convention)",
        "category": "google"
      },
      {
        "name": "STAGING_SCRIPT_ID",
        "description": "Staging Apps Script project ID",
        "category": "apps_script",
        "environment": "staging"
      },
      {
        "name": "PROD_SCRIPT_ID",
        "description": "Production Apps Script project ID",
        "category": "apps_script",
        "environment": "production"
      },
      {
        "name": "STAGING_DEPLOYMENT_ID",
        "description": "Staging Apps Script deployment ID (changes per deploy)",
        "category": "apps_script",
        "environment": "staging"
      },
      {
        "name": "PROD_DEPLOYMENT_ID",
        "description": "Production Apps Script deployment ID",
        "category": "apps_script",
        "environment": "production"
      },
      {
        "name": "SLACK_WEBHOOK_URL",
        "description": "Slack webhook for CI notifications",
        "category": "notifications"
      },
      {
        "name": "TEAMS_WEBHOOK_URL",
        "description": "Microsoft Teams webhook for CI notifications",
        "category": "notifications"
      }
    ]
  },

  "stage2": {
    "description": "Secrets required for Stage-2 testing pipeline",
    "required": [
      {
        "name": "ADMIN_KEY_ROOT",
        "description": "Root brand admin key for API authentication",
        "category": "admin",
        "rotationPolicy": "90 days"
      }
    ],
    "optional": [
      {
        "name": "ADMIN_KEY_ABC",
        "description": "ABC brand admin key",
        "category": "admin"
      },
      {
        "name": "ADMIN_KEY_CBC",
        "description": "CBC brand admin key",
        "category": "admin"
      },
      {
        "name": "ADMIN_KEY_CBL",
        "description": "CBL brand admin key",
        "category": "admin"
      },
      {
        "name": "SPREADSHEET_ID",
        "description": "Root spreadsheet ID (fallback)",
        "category": "testing"
      },
      {
        "name": "SPREADSHEET_ID_ROOT",
        "description": "Root brand test spreadsheet ID",
        "category": "testing"
      },
      {
        "name": "SPREADSHEET_ID_ABC",
        "description": "ABC brand test spreadsheet ID",
        "category": "testing"
      },
      {
        "name": "SPREADSHEET_ID_CBC",
        "description": "CBC brand test spreadsheet ID",
        "category": "testing"
      },
      {
        "name": "SPREADSHEET_ID_CBL",
        "description": "CBL brand test spreadsheet ID",
        "category": "testing"
      },
      {
        "name": "CF_ACCESS_CLIENT_ID",
        "description": "Cloudflare Access client ID for analytics",
        "category": "testing"
      },
      {
        "name": "CF_ACCESS_CLIENT_SECRET",
        "description": "Cloudflare Access client secret for analytics",
        "category": "testing"
      }
    ]
  },

  "cloudflareWorker": {
    "description": "Secrets to be set via wrangler secret put (not GitHub)",
    "secrets": [
      {
        "name": "GOOGLE_SA_CLIENT_EMAIL",
        "description": "Service account email for Worker",
        "command": "wrangler secret put GOOGLE_SA_CLIENT_EMAIL --env {staging|production}"
      },
      {
        "name": "GOOGLE_SA_PRIVATE_KEY_PEM",
        "description": "Private key for Worker",
        "command": "wrangler secret put GOOGLE_SA_PRIVATE_KEY_PEM --env {staging|production}"
      },
      {
        "name": "SHEETS_SPREADSHEET_ID",
        "description": "Database spreadsheet ID for Worker",
        "command": "wrangler secret put SHEETS_SPREADSHEET_ID --env {staging|production}"
      },
      {
        "name": "ADMIN_TOKEN",
        "description": "Admin bearer token for Worker endpoints",
        "command": "wrangler secret put ADMIN_TOKEN --env {staging|production}"
      }
    ]
  },

  "legacy": {
    "description": "Deprecated secrets - migrate to new naming",
    "secrets": [
      {
        "name": "DEPLOYMENT_ID",
        "description": "Deprecated: Use PROD_DEPLOYMENT_ID instead",
        "replacedBy": "PROD_DEPLOYMENT_ID"
      }
    ]
  },

  "scopedTokens": {
    "$comment": "SEC-1.2 - Least-privilege API tokens (replaces global API key usage)",
    "description": "Scoped Cloudflare API tokens following least-privilege principle",
    "documentation": "docs/RUNBOOK-SEC-1.2-SCOPED-API-TOKENS.md",
    "tokens": [
      {
        "name": "CF_DEPLOY_TOKEN",
        "purpose": "CI/CD Worker deployment",
        "permissions": ["Workers Scripts: Edit", "Workers Routes: Edit", "Account Settings: Read"],
        "zoneRestrictions": ["eventangle.com"],
        "rotationPolicy": "90 days",
        "owner": "DevOps Lead",
        "storageLocation": "GitHub Secrets",
        "story": "SEC-1.2"
      },
      {
        "name": "CF_DNS_TOKEN",
        "purpose": "DNS record management",
        "permissions": ["DNS: Edit"],
        "zoneRestrictions": ["eventangle.com"],
        "rotationPolicy": "180 days",
        "owner": "Infrastructure Lead",
        "storageLocation": "Password Manager (manual use only)",
        "story": "SEC-1.2",
        "notes": "Only add to GitHub Secrets if DNS automation is required"
      },
      {
        "name": "CF_AUDIT_TOKEN",
        "purpose": "Read-only monitoring and compliance",
        "permissions": ["Account Settings: Read", "Analytics: Read", "Audit Logs: Read", "Zone: Read", "DNS: Read", "Workers Scripts: Read"],
        "zoneRestrictions": [],
        "rotationPolicy": "180 days",
        "owner": "Security Lead",
        "storageLocation": "Password Manager (manual use only)",
        "story": "SEC-1.2",
        "notes": "Read-only token for monitoring dashboards and compliance checks"
      }
    ],
    "prohibited": [
      {
        "name": "CF_API_KEY",
        "reason": "Legacy global API key - has full account access",
        "alternative": "Use scoped CF_DEPLOY_TOKEN instead"
      },
      {
        "name": "CLOUDFLARE_API_KEY",
        "reason": "Legacy global API key - has full account access",
        "alternative": "Use scoped CF_DEPLOY_TOKEN instead"
      },
      {
        "name": "X-Auth-Key",
        "reason": "Legacy authentication header for global API key",
        "alternative": "Use Authorization: Bearer with scoped token"
      }
    ]
  },

  "categories": {
    "google": {
      "description": "Google Service Account credentials",
      "documentation": "docs/CLOUDFLARE_SECRETS.md#1-google-service-account-google-sheets-api"
    },
    "cloudflare": {
      "description": "Cloudflare deployment credentials (scoped tokens only)",
      "documentation": "docs/RUNBOOK-SEC-1.2-SCOPED-API-TOKENS.md",
      "securityPolicy": "SEC-1.2: All tokens must be scoped with least-privilege permissions"
    },
    "admin": {
      "description": "Admin API authentication",
      "documentation": "docs/CLOUDFLARE_SECRETS.md#3-admin-authentication"
    },
    "apps_script": {
      "description": "Google Apps Script deployment (legacy)",
      "documentation": "docs/CLOUDFLARE_SECRETS.md#4-google-apps-script-legacy"
    },
    "notifications": {
      "description": "CI/CD notification webhooks",
      "documentation": "docs/CLOUDFLARE_SECRETS.md#5-cicd-notifications-optional"
    },
    "testing": {
      "description": "Test configuration secrets",
      "documentation": "docs/CLOUDFLARE_SECRETS.md#6-testing-configuration-stage-2"
    }
  }
}
